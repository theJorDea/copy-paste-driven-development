{
  "uid": "pipeline",
  "title": "Конвейер",
  "tags": ["lab4", "lab5"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [
    { "name": "service", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(up, job)", "refresh": 1, "includeAll": true, "allValue": ".*", "multi": true },
    { "name": "worker", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(pipeline_worker_tasks_total, instance)", "refresh": 1, "includeAll": true, "allValue": ".*", "multi": true }
  ] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Глубина очереди и лимит (сообщения)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "targets": [
      { "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"inference.tasks\"}", "legendFormat": "ready" },
      { "expr": "max by (queue) (pipeline_queue_limit{queue=\"inference.tasks\"})", "legendFormat": "limit" }
    ] },
    { "id": 2, "type": "timeseries", "title": "Источник и воркеры (задач/с)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [
      { "expr": "rate(pipeline_source_tasks_total[1m])", "legendFormat": "source accepted" },
      { "expr": "sum by (instance) (rate(pipeline_worker_tasks_total{outcome=\"ok\",instance=~\"$worker\"}[1m]))", "legendFormat": "worker {{instance}}" }
    ] },
    { "id": 3, "type": "timeseries", "title": "Inference p50/p95/p99 (секунды)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "targets": [
      { "expr": "histogram_quantile(0.50, sum by (le) (rate(pipeline_inference_seconds_bucket{instance=~\"$worker\"}[5m])))", "legendFormat": "p50" },
      { "expr": "histogram_quantile(0.95, sum by (le) (rate(pipeline_inference_seconds_bucket{instance=~\"$worker\"}[5m])))", "legendFormat": "p95" },
      { "expr": "histogram_quantile(0.99, sum by (le) (rate(pipeline_inference_seconds_bucket{instance=~\"$worker\"}[5m])))", "legendFormat": "p99" }
    ] },
    { "id": 4, "type": "timeseries", "title": "Память контейнеров (байты)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "targets": [
      { "expr": "container_memory_working_set_bytes{name=~\".*(app|worker).*\"}", "legendFormat": "{{name}}" }
    ] },
    { "id": 5, "type": "timeseries", "title": "503 и DLQ (число/с)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [
      { "expr": "sum(rate(http_requests_total{status=\"503\"}[1m]))", "legendFormat": "API 503" },
      { "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"inference.tasks.dlq\"}", "legendFormat": "DLQ ready" },
      { "expr": "rate(pipeline_worker_retries_total[1m])", "legendFormat": "worker retries" }
    ] },
    { "id": 6, "type": "logs", "title": "Последние ошибки и события задач", "datasource": { "type": "loki", "uid": "loki" }, "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "targets": [
      { "expr": "{service=~\"$service\"} | json | level=\"ERROR\"", "refId": "A" }
    ], "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending" } },
    { "id": 7, "type": "timeseries", "title": "API latency p50/p95/p99 (секунды)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "targets": [
      { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
      { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
      { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
    ] },
    { "id": 8, "type": "timeseries", "title": "Время ожидания источника при перегрузке (секунды)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "targets": [
      { "expr": "histogram_quantile(0.95, sum by (le) (rate(pipeline_source_wait_seconds_bucket[5m])))", "legendFormat": "p95 backoff" }
    ] }
  ]
}
