# Dev-only RabbitMQ credentials for local Docker Compose
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app-local
RABBITMQ_URL=amqp://app:app-local@rabbitmq:5672/

# Backpressure and repeatable benchmark conditions
TASK_QUEUE_LIMIT=100
TASKS_BACKPRESSURE_ENABLED=true
TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_MS=1000
RETRY_AFTER_SECONDS=2
WORKER_PREFETCH=1
INFERENCE_SECONDS=1
WORKER_GRACEFUL_TIMEOUT=300

# Set only when running the observability profile; exporter is optional.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=always_on
LOG_LEVEL=INFO
GRAFANA_PASSWORD=local-grafana
